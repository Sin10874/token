{
  "name": "tokend-cli",
  "version": "2.5.1",
  "description": "AI 编程成本监控 — 扫描本地日志，同步至云端面板",
  "bin": {
    "tokend-cli": "cli/bin.js"
  },
  "files": [
    "cli/",
    "server/ingestion/",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/index.ts",
    "client:dev": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "prod": "npm run build && NODE_ENV=production tsx server/index.ts",
    "ingest": "tsx server/ingestion/index.ts",
    "test:sync": "tsx tests/cli-sync-contract.ts",
    "test:pricing": "tsx tests/pricing-regression.ts",
    "test:model-refresh": "tsx tests/model-refresh-regression.ts",
    "test:pricing-db": "bash scripts/test-pricing-db.sh",
    "test:pricing-scale": "bash scripts/test-pricing-scale.sh",
    "generate:pricing-sql": "tsx scripts/generate-supabase-pricing.mjs --write",
    "check:pricing-sql": "tsx scripts/generate-supabase-pricing.mjs --check",
    "setup-hooks": "git config core.hooksPath .githooks",
    "update-version-record": "node scripts/update-version-record.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "glob": "^10.4.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.447.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.13"
  }
}
